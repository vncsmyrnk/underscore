#!/usr/bin/env elvish
# vim: set ft=elvish:

use str
use path
use os

if (== (count $args) 0) {
  echo "A collection of wrappers for commonly used commands."
  echo "\nUsage: underscore <SUBCOMMANDS> [FLAGS]"
  echo "\nSubcommands: git init"
  exit 1
}

var share-path = (path:dir (path:abs (src)[name]))'/../share/underscore'
set-env UNDERSCORE_DATA_DIR $share-path

var scripts-path = $share-path$path:separator'scripts'

var i = 1
var script-path = $scripts-path
for arg $args {
  set script-path = $script-path$path:separator$arg
  if (os:is-regular &follow-symlink $script-path'.elv') {
    var remaining-args = (put $args[$i..])
    exec elvish $script-path'.elv' $@remaining-args
  }
  set i = (+ $i 1)
}

echo "No script found." >&2
exit 1
